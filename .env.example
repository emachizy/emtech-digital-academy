# Public — safe to expose to the browser. Vite only inlines VITE_-prefixed vars into the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — read exclusively in src/server/** and TanStack Start server functions.
# Never prefix these with VITE_, or they will be bundled into client-side JavaScript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used for migrations and any server-side query that
# bypasses PostgREST. Use Supabase's pooled connection string (port 6543) for
# serverless-compatible connection reuse; use the direct connection (port 5432)
# only for running migrations.
DATABASE_URL=

# Brevo transactional email API (https://api.brevo.com/v3/smtp/email).
# Never prefix with VITE_ — read only in src/lib/email/brevo.server.ts.
BREVO_API_KEY=

# Base URL used to build absolute links inside emails (server-rendered
# emails have no window.location to read, unlike the browser). Set to the
# real deployed URL in production.
SITE_URL=http://localhost:8080

CORS_ORIGIN=http://localhost:3000
